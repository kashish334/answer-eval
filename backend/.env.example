# Copy this file to .env and fill in whichever key(s) you're using.
# .env itself is gitignored and must never be committed or submitted.
#
# Priority order the pipeline checks, first match wins:
#   1. ANTHROPIC_API_KEY            (Claude - vision extraction + LLM grading)
#   2. GEMINI_API_KEY_1 (/_2 /_3)   (Gemini - rotates to the next key on quota errors)
#   3. GEMINI_API_KEY               (single-key fallback, used if no numbered keys are set)
#   4. none set                     -> fully offline: Tesseract OCR + embedding-only scoring
ANTHROPIC_API_KEY=

# Gemini key rotation: add as many GEMINI_API_KEY_N as you have accounts for.
# When one hits its free-tier quota, the pipeline automatically moves to the next.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
